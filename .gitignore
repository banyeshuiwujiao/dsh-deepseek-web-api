# Logs
*.log
npm-debug.log*

# Dependencies
node_modules/

# Caches
.cache/
*.tsbuildinfo
# pip 装依赖时在仓库根留下的临时目录（pip-build-tracker-*、pip-unpack-* 等）。
# 它们由 pip 的 TMPDIR 决定，默认落在当前工作目录，装完不总清理干净。
pip-*/
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Env / secrets
.env
.env.*
*.local

# 手工改模型目录时留的临时备份（真正的回滚路径是 git 历史，不依赖这些文件）
*.bak-*
